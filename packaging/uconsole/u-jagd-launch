#!/bin/sh
# U-Jagd starter: start the game (it shows new releases and installs one only
# on "Update now"). Game arguments are passed through, e.g. `u-jagd --windowed`.
# U_JAGD_NO_UPDATE=1 also skips the search for new releases for one start.
set -eu
self=$(readlink -f -- "$0")
exec python3 "$(dirname -- "$self")/u_jagd_updater.py" launch "$@"
